# App
# Replace this with a long random value for production.
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
# NEXTAUTH_URL=https://holiday-spend.example.com
# APP_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_DEV_PIN=1234
# ENABLE_EMAIL_PASSWORD=true
# RESEND_API_KEY=re_...
# MAIL_FROM=Holiday Spend <no-reply@example.com>
DATABASE_URL=file:./data/travel.db

