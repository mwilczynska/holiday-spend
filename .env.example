# App
# Replace this with a long random value for production.
NEXTAUTH_SECRET=change-me-to-a-long-random-secret
# NEXTAUTH_URL=https://holiday-spend.example.com
# APP_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_DEV_PIN=1234
# ENABLE_EMAIL_PASSWORD=true
# RESEND_API_KEY=re_...
# MAIL_FROM=Holiday Spend <no-reply@example.com>
HOLIDAY_SPEND_DB_PATH=./data/travel.db
# Administrators who may edit the shared city library: comma-separated emails; required in production.
# AUTH_ADMIN_EMAILS=owner@example.com

# City-cost methodology: v1.2 is the default; v1.1 and v1 are rollbacks.
# CITY_COST_METHODOLOGY_VERSION=v1.2
# CITY_COST_METHODOLOGY_V6 is retired and must not be enabled.

# Optional development fallback LLM keys. Production refuses to start with these; users enter keys in the browser.
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

