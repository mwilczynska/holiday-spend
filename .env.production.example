# Copy to .env.production.local on the deployment host. Never commit the filled file.
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://spend.projectinfinitesummer.com
APP_URL=https://spend.projectinfinitesummer.com
HOLIDAY_SPEND_DB_PATH=/app/data/travel.db
HOLIDAY_SPEND_REQUIRE_DATABASE=true
HOLIDAY_SPEND_TRUST_PROXY=true
AUTH_ALLOWED_EMAILS=
AUTH_ADMIN_EMAILS=
ENABLE_EMAIL_PASSWORD=true
RESEND_API_KEY=
MAIL_FROM=Holiday Spend <no-reply@auth.projectinfinitesummer.com>
# Optional Google sign-in. Register https://spend.projectinfinitesummer.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Supply LLM keys through the browser; no shared server key is required.
