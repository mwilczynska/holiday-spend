      "coefficientKey": "street_food_meal_1p",
      "definition": "street-food meal uses the global direct-evidence prior ratio because the measured paired relation is below the minimum shipping n; the measured rows remain diagnostic evidence",
      "validation": "development_basket_cross_check; measured_relation_below_minimum_n_not_shipped"
    },
    "food_budget": {
      "type": "fixed_basket",
      "inputs": [
        "street_food_meal_1p",
        "inexpensive_restaurant_meal_1p"
      ],
      "validation": "direct_inputs_holdout_required"
    },
    "food_mid_range": {
      "type": "fixed_basket",
      "inputs": [
        "street_food_meal_1p",
        "inexpensive_restaurant_meal_1p",
        "midrange_restaurant_meal_2p"
      ],
      "validation": "direct_inputs_holdout_required"
    },
    "food_high_end": {
      "type": "fixed_basket_with_reasoned_premium_constant",
      "inputs": [
        "inexpensive_restaurant_meal_1p",
        "midrange_restaurant_meal_2p",
        "premium_restaurant_meal_2p"
      ],
      "coefficientKey": "premium_restaurant_meal_2p",
      "validation": "premium_direct_panel_n3_below_minimum; independent validation required"
    },
    "drink_coffee": {
      "type": "measured_production_anchor",
